# Copy to .env locally or configure as private host environment variables.
# Never commit real keys. Never expose them in browser/mobile code.
OPENAI_API_KEY=replace-with-openai-api-key
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
BRIDGE_API_TOKEN=replace-with-a-long-random-secret

# Verify current model availability and pricing in provider dashboards.
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-sonnet-4-5
MAX_OUTPUT_TOKENS=1800
REQUEST_TIMEOUT_SECONDS=90
